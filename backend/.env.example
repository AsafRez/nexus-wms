# Database Connection URL (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-sample-host.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Auth
JWT_SECRET="replace-with-a-secure-jwt-secret"

# Server Port
PORT=3001

